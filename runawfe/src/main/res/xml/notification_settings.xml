<androidx.preference.PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/notifications_settings">

        <ru.runa.wfe.ui.notification.DurationPreference
            app:key="pollingInterval"
            app:title="@string/check_delay_title"
            />

        <Preference
            app:key="tasksSound"
            app:title="@string/tasks_notifications_title"
            app:summary="@string/summary_setup_notifications" />

        <Preference
            app:key="messagesSound"
            app:title="@string/messages_notifications_title"
            app:summary="@string/summary_setup_notifications" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>